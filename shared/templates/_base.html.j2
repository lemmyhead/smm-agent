<!doctype html>
<html>
<head>
<meta charset="utf-8">
{% if font_url %}<link rel="stylesheet" href="{{ font_url }}">{% endif %}
<style>
  :root {
    --primary: {{ primary_color }};
    --accent: {{ accent_color }};
    --w: {{ width }}px;
    --h: {{ height }}px;
    {% block scale %}--u: 1;{% endblock %}
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  html, body { width: var(--w); height: var(--h); overflow: hidden; }
  body {
    position: relative;
    font-family: "{{ font_family }}", "Helvetica Neue", Arial, sans-serif;
    color: #fff;
    background: var(--primary);
  }
  .bg {
    position: absolute; inset: 0;
    background-image: url("{{ background_image_data }}");
    background-size: cover; background-position: center;
  }
  .shade {
    position: absolute; inset: 0;
    background: linear-gradient(180deg, rgba(0,0,0,.15) 0%, rgba(0,0,0,.35) 45%, var(--primary) 130%);
  }
  .content {
    position: absolute; inset: 0;
    display: flex; flex-direction: column; justify-content: space-between;
    {% block padding %}padding: calc(var(--u) * 72px);{% endblock %}
  }
  .logo { height: calc(var(--u) * 84px); max-width: calc(var(--u) * 360px); object-fit: contain; object-position: left center; }
  .campaign {
    font-size: calc(var(--u) * 28px); letter-spacing: .12em; text-transform: uppercase;
    color: var(--accent); font-weight: 700; margin-bottom: calc(var(--u) * 20px);
  }
  .headline {
    font-size: calc(var(--u) * {% block headline_size %}88{% endblock %}px); line-height: 1.05; font-weight: 800;
    display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: {% block headline_lines %}5{% endblock %}; overflow: hidden;
  }
  .cta {
    display: inline-block; margin-top: calc(var(--u) * 44px);
    background: var(--accent); color: var(--primary);
    font-size: calc(var(--u) * 34px); font-weight: 800;
    padding: calc(var(--u) * 20px) calc(var(--u) * 44px); border-radius: 999px;
  }
</style>
</head>
<body>
  {% if background_image_data %}<div class="bg"></div>
  <div class="shade"></div>{% endif %}
  <div class="content">
    <div>{% if logo_data %}<img class="logo" src="{{ logo_data }}" alt="">{% endif %}</div>
    <div>
      <div class="campaign">{{ campaign_name }}</div>
      <div class="headline">{{ headline }}</div>
      {% if cta %}<div class="cta">{{ cta }}</div>{% endif %}
    </div>
  </div>
</body>
</html>
